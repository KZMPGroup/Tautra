{
  "name": "tautra-ui",
  "private": true,
  "version": "1.1.13",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "agent:debug": "cargo build -p tautra-agent",
    "agent:release": "cargo build --release -p tautra-agent",
    "agent:devlog": "cargo build --release -p tautra-agent --features devlog",
    "build:dev": "tauri build --no-bundle --features devlog --config src-tauri/tauri.devlog.conf.json",
    "build:prod": "tauri build --no-bundle"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  }
}
