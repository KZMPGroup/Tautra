{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tautra",
  "mainBinaryName": "tautra-ui",
  "version": "1.1.3",
  "identifier": "id.tautra.app",
  "build": {
    "beforeDevCommand": "npm run agent:debug && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run agent:release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Tautra",
        "width": 1000,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../../target/release/tautra-agent.exe": "tautra-agent.exe"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "installerIcon": "icons/icon.ico", "installerHooks": "windows/hooks.nsh" }
    }
  }
}
